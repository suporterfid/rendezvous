{
    "name": "suporterfid/rendezvous",
    "type": "project",
    "description": "Open-source multi-tenant calendar mash-up platform",
    "keywords": ["calendar", "ics", "webcal", "imap", "invite-ingestion", "sabre-vobject", "laravel", "vue"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "sabre/vobject": "^4.5",
        "webklex/php-imap": "^5.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pest-plugin": "^2.0|^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
